{
    "experiment_name": "smoke_fast",
    "output_dir": "./results",
    "seed": 0,
    "device": "cuda",
    "amp": false,
    "batch_size": 32,
    "epochs": 2,
    "checkpoint_frequency_epochs": 1,
    "dataset": {
        "name": "cifar10",
        "root": "./data/raw",
        "image_size": 32,
        "num_workers": 0
    },
    "backbone": {
        "name": "simple_unet",
        "in_channels": 3,
        "base_channels": 16,
        "channel_mults": [
            1,
            2
        ],
        "num_res_blocks": 1,
        "time_embed_dim": 64
    },
    "optim": {
        "optimizer": "adamw",
        "learning_rate": 0.0002,
        "weight_decay": 0.0,
        "scheduler": "none",
        "scheduler_kwargs": {}
    },
    "evaluation": {
        "metrics": [
            "fid",
            "is"
        ],
        "num_generated_samples": 50,
        "nfe_values": [
            2,
            5
        ],
        "eval_frequency_epochs": 2,
        "fid_reference_cache": "./results/metrics/fid_reference_stats_fast.npz"
    },
    "algorithm_kwargs": {}
}