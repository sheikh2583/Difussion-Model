{
  "experiment_name": "mf_hutchinson_cv",
  "output_dir": "./results",
  "seed": 0,
  "device": "cuda",
  "amp": true,
  "batch_size": 32,
  "epochs": 100,
  "checkpoint_frequency_epochs": 10,
  "dataset": {
    "name": "celeba_latent",
    "root": "./data/raw",
    "image_size": 16,
    "num_workers": 4,
    "cache_dir": "./data/latent_cache",
    "split": "train",
    "codec_checkpoint": "./results/codecs/celeba_vq_f4/accepted_codec.pt"
  },
  "backbone": {
    "name": "simple_unet",
    "in_channels": 3,
    "base_channels": 128,
    "channel_mults": [1, 2, 2],
    "num_res_blocks": 2,
    "time_embed_dim": 256,
    "sample_clamp": false
  },
  "optim": {
    "optimizer": "adamw",
    "learning_rate": 0.00005,
    "weight_decay": 0.0,
    "gradient_clip_norm": 1.0,
    "scheduler": "cosine",
    "scheduler_kwargs": {"eta_min": 0.000001}
  },
  "evaluation": {
    "metrics": ["fid", "is"],
    "num_generated_samples": 5000,
    "nfe_values": [1, 2, 5, 10, 20],
    "eval_frequency_epochs": 25,
    "fid_reference_cache": "./results/metrics/fid_reference_stats_celeba64_latent_ch3.npz"
  },
  "algorithm_kwargs": {
    "p_same": 0.1,
    "p_hutchinson_step": 0.8,
    "n_probes": 4,
    "fd_eps_start": 0.01,
    "fd_eps_end": 0.0001
  }
}
