{
  "experiment_name": "mf_v2_exactjvp",
  "output_dir": "./results",
  "seed": 0,
  "device": "cuda",
  "amp": true,
  "batch_size": 128,
  "epochs": 100,
  "checkpoint_frequency_epochs": 10,
  "dataset": {
    "name": "cifar10",
    "root": "./data/raw",
    "image_size": 32,
    "num_workers": 4
  },
  "backbone": {
    "name": "simple_unet",
    "in_channels": 3,
    "base_channels": 64,
    "channel_mults": [1, 2, 2],
    "num_res_blocks": 2,
    "time_embed_dim": 256
  },
  "optim": {
    "optimizer": "adamw",
    "learning_rate": 0.0001,
    "weight_decay": 0.0001,
    "gradient_clip_norm": 1.0,
    "scheduler": "cosine",
    "scheduler_kwargs": {
      "eta_min": 0.000001
    }
  },
  "evaluation": {
    "metrics": ["fid", "is"],
    "num_generated_samples": 5000,
    "nfe_values": [1, 2, 5, 10, 20],
    "eval_frequency_epochs": 25,
    "fid_reference_cache": "./results/metrics/fid_reference_stats_5k.npz"
  },
  "algorithm_kwargs": {
    "p_same": 0.25,
    "p_fd_step": 0.5,
    "jvp_delta_start": 0.001,
    "jvp_delta_end": 0.0001,
    "use_exact_jvp": true
  }
}
