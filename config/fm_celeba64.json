{
  "experiment_name": "fm",
  "output_dir": "./results",
  "seed": 0,
  "device": "cuda",
  "amp": true,
  "batch_size": 64,
  "epochs": 100,
  "checkpoint_frequency_epochs": 10,
  "dataset": {
    "name": "celeba",
    "root": "./data/raw",
    "image_size": 64,
    "num_workers": 4
  },
  "backbone": {
    "name": "simple_unet",
    "in_channels": 3,
    "base_channels": 64,
    "channel_mults": [
      1,
      2,
      2,
      2
    ],
    "num_res_blocks": 2,
    "time_embed_dim": 256
  },
  "optim": {
    "optimizer": "adamw",
    "learning_rate": 0.0002,
    "weight_decay": 0.0,
    "scheduler": "none",
    "scheduler_kwargs": {}
  },
  "evaluation": {
    "metrics": [
      "fid",
      "is"
    ],
    "num_generated_samples": 5000,
    "nfe_values": [
      1,
      5,
      10,
      20,
      50
    ],
    "eval_frequency_epochs": 25,
    "fid_reference_cache": "./results/metrics/fid_reference_stats_celeba64.npz"
  },
  "algorithm_kwargs": {}
}
